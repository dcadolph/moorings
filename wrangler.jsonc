{
  "name": "macmoorings",
  "main": "site-worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/promo.mp4"]
  },
  "routes": [
    { "pattern": "macmoorings.com", "custom_domain": true },
    { "pattern": "www.macmoorings.com", "custom_domain": true }
  ]
}
